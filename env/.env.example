# Example environment configuration (DO NOT put real secrets in git).
# Copy to env/.env.dev (or .env.staging / .env.prod) and update values.
# If you use flutter_dotenv, remember to add the env file under `flutter: assets:` in pubspec.yaml.

# Shared Schedule backend integration
SHARED_SCHEDULE_API_BASE_URL=
SHARED_SCHEDULE_API_KEY=

# Optional update prompts
APP_UPDATE_URL=
LATEST_APP_VERSION=
MINIMUM_APP_VERSION=

# Telemetry
TELEMETRY_CONSENT_ENABLED=false
