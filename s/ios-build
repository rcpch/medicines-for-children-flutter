#!/usr/bin/env bash
set -euo pipefail

# Build the Flutter iOS app.
# Notes:
# - On CI or local dev machines without signing, use --no-codesign.
# Usage: ./s/build_ios.sh

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

flutter build ios --release --no-codesign
printf "iOS build completed (no-codesign).\n"
