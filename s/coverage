#!/usr/bin/env bash
set -euo pipefail

# Regenerate Flutter test coverage and print overall line coverage.
#
# Outputs:
# - coverage/lcov.info (generated by `flutter test --coverage`)

flutter test --coverage

if [[ ! -f coverage/lcov.info ]]; then
  echo "ERROR: coverage/lcov.info was not generated." >&2
  exit 1
fi

pct=$(awk -F: '/^LF:/{lf+=$2} /^LH:/{lh+=$2} END{ if(lf>0) printf("%.1f", (100*lh/lf)); else printf("0.0") }' coverage/lcov.info)

echo "Coverage: ${pct}%"
